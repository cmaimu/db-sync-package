{
    "name": "cmdimu/db-sync-package",
    "description": "Database Sync Package for Laravel, CodeIgniter 4, and CodeIgniter 3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "cmdimu"
        }
    ],
    "keywords": [
        "database",
        "sync",
        "laravel",
        "codeigniter",
        "ci4",
        "ci3"
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "DbSync\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DbSync\\Adapters\\LaravelServiceProvider"
            ]
        }
    }
}
